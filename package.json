{
  "name": "coverwise-mcp",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "description": "Claude Code plugin: pairwise / t-wise combinatorial coverage for AI-written tests, backed by the coverwise WASM engine",
  "license": "Apache-2.0",
  "author": "libraz <libraz@libraz.net>",
  "bin": "./mcp/cli.mjs",
  "homepage": "https://github.com/libraz/coverwise-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libraz/coverwise-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/libraz/coverwise-mcp/issues"
  },
  "keywords": [
    "claude-code",
    "mcp",
    "pairwise",
    "t-wise",
    "combinatorial",
    "testing",
    "coverage"
  ],
  "scripts": {
    "start": "node mcp/server.mjs",
    "init": "node mcp/cli.mjs init",
    "uninstall": "node mcp/cli.mjs uninstall",
    "lint": "biome check mcp/ scripts/ tests/",
    "lint:fix": "biome check --write mcp/ scripts/ tests/",
    "format": "biome format --write mcp/ scripts/ tests/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@libraz/coverwise": "^1.6.3",
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
